# ==============================================================================
# Apache Configuration for cybeasy.com/Tasbeeh-Al-Muslim/
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /Tasbeeh-Al-Muslim/

    # 1. Block access to hidden files (.git, .env) and source code directory
    RewriteRule ^\. - [F,L]
    RewriteRule ^code/ - [F,L]

    # 2. Allow direct access to API v3 and PHP files
    RewriteCond %{REQUEST_URI} ^/Tasbeeh-Al-Muslim/api/ [NC,OR]
    RewriteCond %{REQUEST_URI} \.php$ [NC]
    RewriteRule ^ - [L]

    # 3. Allow existing files and directories (Landing Page, App, Assets)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/wasm
</IfModule>
